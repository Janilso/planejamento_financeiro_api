{
  "name": "planejamento_financeiro_api",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' vitest.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/migrations/run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API do Planejamento Financeiro: login com Google e lançamentos de ganhos e gastos mês a mês",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "mongodb-memory-server-core": "^11.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
