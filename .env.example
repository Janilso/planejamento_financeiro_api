# Copie para .env e preencha. Nunca versione o .env.
PORT=8080
NODE_ENV=development

# Conexão com o MongoDB (Atlas em produção, local em desenvolvimento).
MONGO_URI=mongodb://127.0.0.1:27017/planejamento_dev

# Client ID que aparece como audiência (aud) no idToken do app:
# o "Web client" do projeto Firebase.
GOOGLE_CLIENT_ID=

# Segredos dos tokens de acesso e de refresh (use valores longos e diferentes).
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Limite de requisições por IP a cada 15 minutos (login/refresh e demais rotas).
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=300

# Número de proxies confiáveis na frente da API (0 se ela recebe o tráfego direto).
TRUST_PROXY=0
